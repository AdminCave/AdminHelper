{
  "profiles": {
    "linux-full": {
      "template_tag": "ah-tpl-linux-full",
      "bootstrap": "full",
      "base": "base-ubuntu",
      "note": "the fat template: toolchains, docker, caches — what the heavy tiers run on"
    },
    "linux-server": {
      "template_tag": "ah-tpl-linux-server",
      "bootstrap": "server",
      "base": "base-ubuntu",
      "note": "server/agent roles: no desktop, no display, no browser"
    },
    "base-ubuntu": {
      "template_tag": "ah-tpl-base-ubuntu",
      "note": "plain cloud image, the source every bake clones from"
    },
    "base-debian": {
      "template_tag": "ah-tpl-base-debian",
      "note": "plain cloud image for the .deb/apt-repo roles"
    },
    "base-freebsd": {
      "template_tag": "ah-tpl-base-freebsd",
      "note": "FreeBSD's own cloud image, imported by `vm.py import` — the agent's FreeBSD box",
      "image": {
        "url": "https://download.freebsd.org/releases/VM-IMAGES/15.1-RELEASE/amd64/Latest/FreeBSD-15.1-RELEASE-amd64-BASIC-CLOUDINIT-ufs.qcow2.xz",
        "sha256": "e4ca4db889f8559c9b9dfcacc70405c038476f4b6d41649b152d3809a2ed9e1f"
      }
    }
  },
  "roles": {
    "server": {"memory": 4096, "cores": 4},
    "desktop": {"memory": 6144, "cores": 6},
    "gui": {"memory": 6144, "cores": 6},
    "agent": {"memory": 2048, "cores": 2},
    "tunnel": {"memory": 2048, "cores": 2},
    "visitor": {"memory": 2048, "cores": 2},
    "moncheck": {"memory": 2048, "cores": 2},
    "rpm": {"memory": 2048, "cores": 2},
    "probe": {"memory": 2048, "cores": 2},
    "freebsd": {"memory": 2048, "cores": 2},
    "bake": {"memory": 4096, "cores": 6}
  }
}
