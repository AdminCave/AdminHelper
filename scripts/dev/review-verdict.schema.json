{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "review-verdict.schema.json",
  "title": "AdminHelper review verdict",
  "description": "What a task reviewer hands to task-close.sh (--review verdict:<file>). Checked by review.sh check-verdict with python3 alone: type, required, properties, additionalProperties, items, enum, const, pattern, minLength, minimum.",
  "type": "object",
  "required": ["schema_version", "task", "tree_hash", "reviewer", "verdict", "findings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "task": {
      "type": "object",
      "required": ["ledger", "id"],
      "additionalProperties": false,
      "properties": {
        "ledger": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
      }
    },
    "tree_hash": {
      "description": "scripts/dev/tree-hash.sh of the staged tree the reviewer saw",
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "reviewer": {
      "type": "object",
      "required": ["model", "effort"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "effort": { "type": "string", "minLength": 1 }
      }
    },
    "verdict": { "enum": ["approve", "request_changes", "needs_decision"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "file", "claim"],
        "additionalProperties": false,
        "properties": {
          "severity": { "enum": ["blocker", "wichtig", "nit"] },
          "file": { "type": "string" },
          "line": { "type": ["integer", "null"] },
          "claim": { "type": "string", "minLength": 1 },
          "evidence": {
            "description": "the concrete input and the wrong result; a blocker without it counts as a nit",
            "type": "string"
          }
        }
      }
    },
    "probe": {
      "description": "scripts/dev/review-probe.sh: is the new test red without the change?",
      "type": "object",
      "required": ["applicable"],
      "additionalProperties": false,
      "properties": {
        "applicable": { "type": "boolean" },
        "reason": { "type": "string" },
        "red_without_change": { "type": ["boolean", "null"] }
      }
    },
    "verify": { "description": "filled by the runner from .ah-out/last-verify.json", "type": "object" },
    "contracts": { "description": "filled by the runner from review.sh contracts", "type": ["object", "array"] },
    "cost_usd": { "description": "filled by the runner", "type": "number", "minimum": 0 }
  }
}
