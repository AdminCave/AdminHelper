#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Kevin Stenzel
#
# SPDX-License-Identifier: GPL-3.0-or-later
#
# commit-msg — git hook: `review.sh sec --message` over the message of a
# `git commit` or a merge commit of `git merge` (R-0197). Only those two run it
# (githooks(5)); cherry-pick, revert, rebase and `git am` leave their messages to
# pre-push and the CI guard.
#
# pre-commit reads only what is staged; the message came into view with pre-push
# and the CI guard (`--range`, R-0183), when the commit already lay in the local
# history. git hands over the message file ($1), and review.sh reads all of it.
# When git brought up an editor, the hook says so (--editor), and only then does
# the diff that `commit -v` puts below the scissors line not count: a scissors line
# typed into -m or -F stays in the commit with what follows it (R-0213). With -v as
# well git cuts there after all; reading it then is the stricter direction.
# githooks(5): git runs every commit hook with GIT_EDITOR=: when no editor comes
# up, whatever the caller set.
# `git commit --no-verify` skips this hook like pre-commit; the harness guard
# refuses that flag (R-0102).
#
# The subject — the first line that is neither empty nor a # comment — must be a
# Conventional Commit (R-1359): three task commits on main carry `Task: …` or
# running text as their subject. Merge, revert and fixup!/squash!/amend! subjects,
# which git writes itself, pass. task-close.sh runs the same check before its Verify.
#
# Exit ≠ 0 aborts the commit: 1 for a subject that is no Conventional Commit, 4 for
# a finding, anything else when review.sh could not run — fail closed, like
# pre-commit.

set -uo pipefail

ROOT="$(cd "$(dirname "$0")/../../.." && pwd)" || exit 2
MSG="${1:?commit-msg: git passes the message file}"
SUBJECT_RE='^((feat|fix|chore|refactor|docs|test|perf|tune|build|ci|style|revert)(\([^)]+\))?!?: [^[:space:]]|Merge |Revert "|(fixup|squash|amend)! )'
# A # line is a comment only when git ran an editor (it then strips it); with
# -m or -F (GIT_EDITOR=:) git keeps it, and it is the subject.
SKIP='^[[:space:]]*(#|$)'
[ "${GIT_EDITOR-}" = : ] && SKIP='^[[:space:]]*$'
SUBJECT="$(awk -v skip="$SKIP" '$0 !~ skip { print; exit }' "$MSG")" || exit 2
[[ $SUBJECT =~ $SUBJECT_RE ]] || {
  # Not echoed: a subject may carry what review.sh sec would refuse.
  echo "commit-msg: the subject is no Conventional Commit (<type>[(scope)][!]: <text>)" >&2
  exit 1
}
[ "${GIT_EDITOR-}" = : ] && exec bash "$ROOT/scripts/dev/review.sh" sec --message "$MSG"
exec bash "$ROOT/scripts/dev/review.sh" sec --message "$MSG" --editor
