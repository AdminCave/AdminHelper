# pre-applypatch — git hook: `review.sh sec --staged` for `git am` and
# `git rebase --apply` (also via rebase.backend=apply), which run none of
# pre-commit, prepare-commit-msg and pre-merge-commit (R-0110). githooks(5):
# invoked after the patch is applied to the index, before the commit is made;
# a non-zero exit stops it — `git am --abort` or `git rebase --abort` goes back.
# `git am -n`/`--no-verify` skips this hook, and no other runs for git am: the
# one flag past all four hooks, documented in DEVELOPMENT.md.
#
# Exit ≠ 0 stops the commit: 4 for a finding, anything else when review.sh could
# not run — fail closed, like pre-commit.

set -uo pipefail

ROOT="$(cd "$(dirname "$0")/../../.." && pwd)" || exit 2
exec bash "$ROOT/scripts/dev/review.sh" sec --staged
