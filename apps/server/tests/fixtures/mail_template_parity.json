{
  "_comment": "Inputs and expected output of the mail template renderer (R-1533). The renderer lives in apps/pycommon/ah_common/mail_template.py; apps/server/tests/test_notify_mail_template.py renders each case; template.logo true stands for any logo bytes.",
  "cases": [
    {
      "name": "no template: the mail as before",
      "template": {},
      "values": {
        "title": "Disk full on web01",
        "body": "Disk / at 97 %\nfree: 1.2 GB",
        "severity": "critical",
        "category": "monitoring",
        "time": "2026-11-18 12:00 UTC",
        "source": "AdminHelper"
      },
      "expected": {
        "subject": "Disk full on web01",
        "from_name": "",
        "text": "Disk / at 97 %\nfree: 1.2 GB",
        "html": null,
        "logo": false
      }
    },
    {
      "name": "prefix and sender name only",
      "template": {
        "subject_prefix": "[Ops]",
        "from_name": "Ops Desk"
      },
      "values": {
        "title": "Disk full on web01",
        "body": "Disk / at 97 %\nfree: 1.2 GB",
        "severity": "critical",
        "category": "monitoring",
        "time": "2026-11-18 12:00 UTC",
        "source": "AdminHelper"
      },
      "expected": {
        "subject": "[Ops] Disk full on web01",
        "from_name": "Ops Desk",
        "text": "Disk / at 97 %\nfree: 1.2 GB",
        "html": null,
        "logo": false
      }
    },
    {
      "name": "text part only",
      "template": {
        "text": "{{severity}} | {{title}}\n\n{{body}}\n-- {{source}}, {{time}}, {{category}} {{logo}}"
      },
      "values": {
        "title": "Disk full on web01",
        "body": "Disk / at 97 %\nfree: 1.2 GB",
        "severity": "critical",
        "category": "monitoring",
        "time": "2026-11-18 12:00 UTC",
        "source": "AdminHelper"
      },
      "expected": {
        "subject": "Disk full on web01",
        "from_name": "",
        "text": "critical | Disk full on web01\n\nDisk / at 97 %\nfree: 1.2 GB\n-- AdminHelper, 2026-11-18 12:00 UTC, monitoring ",
        "html": null,
        "logo": false
      }
    },
    {
      "name": "html part escapes values and breaks lines",
      "template": {
        "html": "<h1>{{ title }}</h1><p>{{body}}</p><i>{{severity}}</i>"
      },
      "values": {
        "title": "<script>alert(1)</script> & \"q\" 'a'",
        "body": "a < b\r\nc > d",
        "severity": "critical",
        "category": "monitoring",
        "time": "2026-11-18 12:00 UTC",
        "source": "AdminHelper"
      },
      "expected": {
        "subject": "<script>alert(1)</script> & \"q\" 'a'",
        "from_name": "",
        "text": "a < b\r\nc > d",
        "html": "<h1>&lt;script&gt;alert(1)&lt;/script&gt; &amp; &quot;q&quot; &#x27;a&#x27;</h1><p>a &lt; b<br>\nc &gt; d</p><i>critical</i>",
        "logo": false
      }
    },
    {
      "name": "a value naming a placeholder stays as it is",
      "template": {
        "text": "{{title}} / {{body}}",
        "html": "{{title}}"
      },
      "values": {
        "title": "{{body}}",
        "body": "{{severity}}",
        "severity": "critical",
        "category": "monitoring",
        "time": "2026-11-18 12:00 UTC",
        "source": "AdminHelper"
      },
      "expected": {
        "subject": "{{body}}",
        "from_name": "",
        "text": "{{body}} / {{severity}}",
        "html": "{{body}}",
        "logo": false
      }
    },
    {
      "name": "an unknown placeholder stays literal at send time",
      "template": {
        "text": "{{title}} {{nope}}",
        "html": "{{nope}}"
      },
      "values": {
        "title": "Disk full on web01",
        "body": "Disk / at 97 %\nfree: 1.2 GB",
        "severity": "critical",
        "category": "monitoring",
        "time": "2026-11-18 12:00 UTC",
        "source": "AdminHelper"
      },
      "expected": {
        "subject": "Disk full on web01",
        "from_name": "",
        "text": "Disk full on web01 {{nope}}",
        "html": "{{nope}}",
        "logo": false
      }
    },
    {
      "name": "logo with a logo set",
      "template": {
        "html": "<img src=\"{{logo}}\">{{title}}",
        "logo": true
      },
      "values": {
        "title": "Disk full on web01",
        "body": "Disk / at 97 %\nfree: 1.2 GB",
        "severity": "critical",
        "category": "monitoring",
        "time": "2026-11-18 12:00 UTC",
        "source": "AdminHelper"
      },
      "expected": {
        "subject": "Disk full on web01",
        "from_name": "",
        "text": "Disk / at 97 %\nfree: 1.2 GB",
        "html": "<img src=\"cid:logo\">Disk full on web01",
        "logo": true
      }
    },
    {
      "name": "logo without a logo set",
      "template": {
        "html": "<img src=\"{{logo}}\">{{title}}"
      },
      "values": {
        "title": "Disk full on web01",
        "body": "Disk / at 97 %\nfree: 1.2 GB",
        "severity": "critical",
        "category": "monitoring",
        "time": "2026-11-18 12:00 UTC",
        "source": "AdminHelper"
      },
      "expected": {
        "subject": "Disk full on web01",
        "from_name": "",
        "text": "Disk / at 97 %\nfree: 1.2 GB",
        "html": "<img src=\"\">Disk full on web01",
        "logo": false
      }
    }
  ]
}
