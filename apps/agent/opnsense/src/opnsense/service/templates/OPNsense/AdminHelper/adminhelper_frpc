#
# This file is automatically generated. Do not manually edit this file - changes *will* be lost!
#
{% if (not helpers.exists('OPNsense.AdminHelper.enabled') or OPNsense.AdminHelper.enabled == '1') and helpers.file_exists('/usr/local/etc/adminhelper/frp/frpc.toml') %}
adminhelper_frpc_enable="YES"
{% else %}
adminhelper_frpc_enable="NO"
{% endif %}
