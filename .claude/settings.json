{
  "permissions": {
    "allow": [
      "Bash(python3 scripts/vm/vm.py:*)",
      "Bash(bash scripts/vm/*.sh:*)",
      "Bash(bash scripts/tests/multibox.sh:*)",
      "Bash(bash scripts/tests/heavy.sh:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go build:*)",
      "Bash(gofmt:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo check:*)",
      "Bash(npm run:*)",
      "Bash(bash scripts/tests/run.sh:*)",
      "Bash(bash scripts/dev/verify.sh:*)",
      "Bash(bash scripts/dev/format-file.sh:*)",
      "Bash(reuse annotate:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git revert:*)",
      "Bash(git rev-parse:*)"
    ],
    "ask": [
      "Bash(bash scripts/vm/bootstrap_linux.sh:*)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/dev/hooks/harness-guard.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/dev/hooks/session-status.sh\""
          }
        ]
      }
    ]
  }
}
